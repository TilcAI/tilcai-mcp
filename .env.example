# Which TilcAI environment this process serves: testnet (Avalanche Fuji -> Stellar Testnet) or
# mainnet (Avalanche C-Chain -> Stellar Public Network, real USDC). One process = one environment.
TILCAI_NETWORK=testnet
# Base URL of tilcai-infrastructure's API for that environment.
# Defaults: testnet http://192.168.1.57:8787 · mainnet http://127.0.0.1:18787 (tilcai-mainnet, loopback only).
TILCAI_API_URL=http://192.168.1.57:8787
# Bearer key of that environment. Mainnet uses its own keys (TILCAI_API_KEYS_MAINNET on the server);
# testnet keys are rejected there.
TILCAI_API_KEY=
